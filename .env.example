# Copy to .env. Credentials stay on this computer and are ignored by Git.
# Local demo works without configuration using .runtime/fandian.db (SQLite).
# MySQL setup can use separate fields so special characters in passwords need no URL encoding.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fandian
USE_MYSQL=false
# Alternatively set DATABASE_URL=mysql+pymysql://user:encoded-password@127.0.0.1:3306/fandian?charset=utf8mb4

APP_MODE=demo
# Source web development only. Desktop ignores these and requires App model settings.
# Never put a real key in this tracked example file.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
MCP_ENABLED=true
